@inherits LayoutComponentBase

<style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #222; }
    main { max-width: 960px; margin: 0 auto; padding: 24px; }
    label { display: block; font-size: 13px; margin-bottom: 4px; color: #555; }
    input, select, button { padding: 6px 8px; font-size: 14px; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
    .box { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 16px; margin-bottom: 16px; }
    code { background: #eef; padding: 2px 4px; word-break: break-all; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    nav a { margin-right: 12px; }
    th, td { text-align: left; border-bottom: 1px solid #eee; padding: 6px; }
</style>

<main>
    <h2>web-crawler</h2>
    <nav>
        <a href="/">RSS</a>
        <a href="/short">RSS Short</a>
    </nav>
    <hr />
    @Body
</main>
